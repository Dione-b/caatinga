access=public
prefer-workspace-packages=true
link-workspace-packages=true

# Hoist mermaid runtime deps so VitePress dev (vitepress-plugin-mermaid)
# can pre-bundle them via optimizeDeps. Affects node_modules layout only,
# not pnpm-lock.yaml, so --frozen-lockfile CI installs stay consistent.
public-hoist-pattern[]=dayjs
public-hoist-pattern[]=cytoscape
public-hoist-pattern[]=cytoscape-cose-bilkent
public-hoist-pattern[]=@braintree/sanitize-url
public-hoist-pattern[]=debug