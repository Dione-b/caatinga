{
  "name": "@caatinga/cli",
  "version": "3.5.1",
  "description": "Caatinga CLI for building dApps on Stellar/Soroban",
  "keywords": [
    "stellar",
    "soroban",
    "cli",
    "dapp",
    "smart-contracts",
    "blockchain",
    "web3",
    "caatinga"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dione-b/caatinga.git",
    "directory": "packages/cli"
  },
  "homepage": "https://dione-b.github.io/caatinga/",
  "author": "Caatinga contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "caatinga": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "pnpm build",
    "build": "tsup src/index.ts --format esm --dts --clean && rm -rf ./templates && mkdir ./templates && (cd ../templates && tar --exclude=node_modules --exclude=dist -cf - .) | (cd ./templates && tar -xf -)",
    "predev": "pnpm --filter @caatinga/core build",
    "dev": "tsx src/index.ts",
    "test": "vitest run --pool=threads",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@caatinga/core": "^3.5.1",
    "@caatinga/zk": "^3.5.1",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
